{
  "schema": "port-dt-yard-lighting-v3-safe-config.v1",
  "version": "V3.1",
  "dataset": {
    "data_dir": "app/services/rl_model/yard_lighting/data",
    "public_port_path": "data/rl/datasets/public_cn_sha_hourly_v3.csv",
    "public_port_meta_path": "data/rl/datasets/public_cn_sha_hourly_v3.meta.json",
    "evidence_tier": "public_reanalysis_enriched_engineering_emulator_replay",
    "measured": false,
    "expected_interval_minutes": 5,
    "minimum_aggregate_rows": 2500,
    "expected_zones": 96
  },
  "split": {"train_ratio": 0.70, "validation_ratio": 0.10, "blind_test_ratio": 0.20},
  "action": {
    "base_dimming_residual_ratio": [-0.10, 0.04],
    "activity_gain_ratio": [0.0, 0.08],
    "weather_gain_ratio": [0.0, 0.05],
    "action_ramp_per_5min": [0.04, 0.03, 0.02]
  },
  "counterfactual": {
    "fixture_standby_power_fraction": 0.35,
    "fixture_dimming_power_fraction": 0.65,
    "minimum_lux_margin_standard": 1.005,
    "minimum_lux_margin_high_activity": 1.015,
    "minimum_lux_margin_critical": 1.08,
    "high_activity_threshold": 0.60,
    "visibility_weather_risk_threshold": 0.65,
    "demand_charge_cny_per_kw_window": 4.0,
    "carbon_shadow_price_cny_per_kg": 0.04,
    "annual_operating_hours": 8760,
    "source": "explicit_conservative_fixture_and_lux_counterfactual_not_site_calibration"
  },
  "training": {
    "seeds": [67, 167, 267],
    "episode_steps": 96,
    "teacher_trajectories_per_seed": 12,
    "epochs": 60,
    "validation_every_epochs": 10,
    "batch_size": 256,
    "learning_rate": 0.001,
    "network": [64, 64]
  },
  "convergence_gate": {
    "fixed_validation_windows": 3,
    "loss_reduction_min": 0.80,
    "tail_relative_range_max": 0.015
  },
  "business_gate": {
    "cost_reduction_percent_min": 1.0,
    "energy_reduction_percent_min": 1.0,
    "peak_reduction_percent_min": 0.10,
    "minimum_lux_compliance_rate": 1.0,
    "critical_lux_compliance_rate": 1.0,
    "guardrail_violation_rate_max": 0.0
  }
}

{
  "schema_version": "port_business_kpi_benchmark_v1",
  "benchmark_id": "public_port_ops_coordinated_dispatch_v1",
  "dataset_id": "public_port_ops_v1",
  "dataset_path": "data/rl/datasets/public_port_ops_v1.csv",
  "split": {
    "method": "chronological_calendar_boundaries_no_shuffle",
    "train_end_exclusive": "2024-01-01T00:00:00Z",
    "validation_end_exclusive": "2025-01-01T00:00:00Z"
  },
  "baseline": {
    "name": "static_fcfs_fixed_energy_schedule",
    "berth_uncertainty_buffer_hours_per_vessel": 4.0,
    "bess_dispatch": "idle",
    "flexible_load_dispatch": "fixed_timetable"
  },
  "coordinated_policy": {
    "name": "multi_agent_orchestration_plus_joint_policy",
    "berth_uncertainty_buffer_hours_per_vessel": 2.0,
    "crane_productivity_teu_per_hour": 35.0,
    "cranes_per_berth": 4,
    "congestion_wait_base_hours": 3.5,
    "throughput_pressure_coefficient_hours": 0.35,
    "tide_pressure_coefficient_hours": 0.0,
    "bess_capacity_kwh": 50000.0,
    "bess_power_kw": 4000.0,
    "bess_initial_soc": 0.55,
    "bess_min_soc": 0.15,
    "bess_max_soc": 0.9,
    "bess_roundtrip_leg_efficiency": 0.94,
    "flexible_load_shift_fraction": 0.4,
    "low_price_threshold": 0.72,
    "high_price_threshold": 1.34,
    "terminal_energy_reference_price": 1.0
  },
  "metric_definitions": {
    "berth_utilization": "productive berth-hours divided by productive plus reserved uncertainty berth-hours",
    "average_waiting_hours": "arrival-weighted congestion delay plus one-half of the reserved uncertainty buffer",
    "scenario_energy_cost": "hourly grid energy times tariff, with BESS state reset and terminal BESS plus deferred-load energy settled at the declared reference price for each UTC day"
  },
  "sensitivity": {
    "berth_uncertainty_buffer_hours_per_vessel": [1.5, 2.0, 2.5],
    "bess_power_kw": [3000.0, 4000.0, 5000.0],
    "flexible_load_shift_fraction": [0.3, 0.4, 0.5]
  },
  "claim_rounding": {
    "berth_utilization_relative_improvement_percent": 0,
    "average_waiting_time_reduction_percent": 0,
    "scenario_energy_cost_reduction_percent": 0
  },
  "evidence_boundary": {
    "official_public_inputs": [
      "MPA Singapore monthly container throughput, 2020-2025",
      "MPA Singapore monthly container-vessel arrivals, 2020-2025"
    ],
    "engineering_derivatives": [
      "hourly load",
      "hourly throughput allocation",
      "hourly allocation of monthly vessel arrivals",
      "tariff",
      "carbon factor",
      "ambient temperature"
    ],
    "official_input_geography_coherent": true,
    "geographically_coherent_single_port_series": false,
    "scenario_parameters_measured_or_calibrated_at_port": false,
    "policy_parameters_calibrated_from_measured_outcomes": false,
    "berth_wait_causal_identification": false,
    "counterfactual_outcomes": "digital_twin_simulation_only",
    "measured_port_kpi": false,
    "production_claim_allowed": false
  }
}

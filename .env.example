# PortViz defaults to a deterministic projection driven by the canonical dataset.
PORTVIZ_MODE=dataset
PORTVIZ_DATASET_PATH=data/rl/datasets/public_port_ops_v1.csv
PORTVIZ_CONFIG=app/services/portviz/port_sgsin_demo.json

# Canonical dataset replay used by telemetry + data-driven forecasting.
PORT_DT_TELEMETRY_DATASET=data/rl/datasets/public_port_ops_v1.csv

# For measured/replayed entity tracks:
# PORTVIZ_MODE=real
# PORTVIZ_FRAME_PATH=/absolute/path/to/port_frames.jsonl

# External REST adapters. Leave blank to use their explicitly labelled simulator.
PORT_TOS_BASE=
PORT_TOS_TOKEN=
AIS_BASE_URL=
AIS_TOKEN=
TIDE_BASE_URL=
TIDE_TOKEN=
MARKET_BASE_URL=
MARKET_TOKEN=

# Optional combined schedule/weather/TOU REST adapter. With PORTDT_REAL=1,
# remote failures are returned as errors and never fall back to generated data.
PORTDT_REAL=0
PORTDT_BASE_URL=
PORTDT_API_KEY=
PORTDT_POWER_URL=
PORTDT_WEATHER_URL=
PORTDT_AIS_URL=

# Legacy UI/contract simulators are opt-in and never production data.
# PORT_DT_ENABLE_ENGINEERING_SIMULATORS=1
# PORT_DT_ENABLE_LEGACY_RL=1
# PORT_DT_ALLOW_DEMO_ESG=1
# PORT_DT_ENABLE_TWINPLUS_DEMO=1
# PORT_DT_ENABLE_LEGACY_CLOSEDLOOP=1

# Optional local desktop integrations are disabled by default and never expose
# workstation paths or launch commands through the public status APIs.
# PORT_DT_ENABLE_DESKTOP_INTEGRATIONS=1
# XIAOYI_AI_BASE_URL=http://127.0.0.1:8010
# XIAOYI_AI_PROJECT=/private/path/to/xiaoyi
# XIAOYI_AI_START_COMMAND=./run.sh
# SAILING_SIM_PROJECT=/private/path/to/godot-project
# SAILING_SIM_GODOT=/private/path/to/godot-executable

# Southbound execution is fail-closed. Copy config/actuators.example.json to a
# private path, replace site endpoints, then point this variable to that file.
# PORT_DT_ACTUATOR_CONFIG=/absolute/private/path/actuators.json
# PORT_DT_HTTP_ACTUATOR_TOKEN=
# PORT_DT_MQTT_PASSWORD=
# PORT_DT_SECOND_CHANNEL_TOKEN=replace-with-a-separate-32-plus-character-secret
# Explicit dry-run routes additionally require this opt-in:
# PORT_DT_ENABLE_ACTUATOR_DRY_RUN=1

# Auditable twin entity graph and site calibration evidence. The example files
# are schemas only; copy them to a private site path and replace every value.
# PORT_DT_TWIN_GRAPH_PATH=/absolute/private/path/twin_graph.json
# PORT_DT_TWIN_CALIBRATION_PATH=/absolute/private/path/twin_calibration.json

# Runtime hardening. In production, all /api/*, /external/* and /metrics calls
# require X-API-Key. Never commit real keys.
PORT_DT_ENV=development
# PORT_DT_CORS_ORIGINS=https://operations.example.com
# PORT_DT_API_KEYS=replace-with-a-long-random-key
# PORT_DT_ADMIN_API_KEYS=replace-with-a-different-long-random-admin-key
# PORT_DT_ALLOW_MODEL_PROMOTION=1
# PORT_DT_MAX_GUARDRAIL_VIOLATION_RATE=0.05
# PORT_DT_MAX_DATASET_UPLOAD_MB=50
# PORT_DT_MAX_CONCURRENT_TRAINING=1
# PORT_DT_MAX_CONCURRENT_EVALUATION=2
# PORT_DT_MAX_TRAINING_STEPS=5000000

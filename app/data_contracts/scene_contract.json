      ]
    }
  },
  "integration_targets": {
    "twin_input_adapter": "mock://twin/scene_state",
    "twin_output_adapter": "mock://twin/scene_output",
    "future_real_targets": [
      "real://tos/berth-plan",
      "real://yard/wip-snapshot",
      "real://gate/queue-stream",
      "real://energy/submeter-aggregate"
    ]
  },
  "switching_policy": {
    "mode": "mock_first_adapter_ready",
    "ui_should_not_change_when_switching": true,
    "required_to_go_real": [
      "stable scene_id and time bucket key",
      "validated berth/yard/gate timestamp alignment",
      "documented missing-value fallback"
    ]
  }
}
